# Segreti: SECRETS_BACKEND=env li legge da qui (in Docker: env_file del compose); keyvault da Azure Key Vault
SECRETS_BACKEND=env
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
JUDGE_MODEL=gemma-4-31b-it

AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_NOTES_CONTAINER=notes
COSMOS_ENDPOINT=http://localhost:8081
COSMOS_KEY=<emulator-key-from-microsoft-docs>
COSMOS_DATABASE=nihongo
COSMOS_CONTAINER=notes


# Indice degli appunti per la chat: local (data/notes_index.json) oppure cosmos
NOTES_BACKEND=local